    <string name="chart_ok_duration_s">Sufficient duration (%1$ds) to show trends, not just isolated peaks.</string>
    <string name="chart_warn_short">Very short session: conclusions are only approximate.</string>
    <string name="chart_err_speed_oscillates">Speed fluctuates a lot: could be GPS, choppy water, or abrupt pace changes.</string>
    <string name="chart_improve_smoother">Try steadier segments and check the signal: analysis works better with smoother lines.</string>
    <string name="chart_ok_spm_steady">SPM is relatively stable: good stroke-rate consistency overall.</string>
    <string name="chart_err_spm_vary">Large SPM variation: pace changes a lot from moment to moment.</string>
    <string name="chart_improve_spm">Fixed-pace work, cox callouts, or a clear target SPM in short blocks.</string>
    <string name="chart_err_fatigue">Average speed clearly drops at the end vs. the start (fatigue or stroke quality loss).</string>
    <string name="chart_improve_fatigue">Build endurance, keep technique in the last minutes, hydration, and plan intensity.</string>
    <string name="chart_ok_late_speed">Speed holds up well toward the end of the session.</string>
    <string name="chart_err_low_efficiency">Stretches with high SPM and relatively low speed: stroke may be inefficient or the boat may feel “heavy”.</string>
    <string name="chart_improve_efficiency">Focus on foot–seat connection, front of the stroke, and light hands without racing the recovery.</string>
    <string name="chart_ok_speed_spike">Clear speed spike above the average: strong application or wind/water assist.</string>
    <string name="chart_improve_low_mean_speed">Very low mean speed: could be idling, weak GPS, or a technical course; compare with how the boat felt.</string>
    <string name="chart_ok_recorded">Session recorded; check visually that the blue and orange curves move together in key parts.</string>
    <string name="chart_info_no_strong_neg">No strongly negative patterns were found automatically.</string>
    <string name="chart_improve_compare">Compare with other similar sessions and validate with a coach on the dock.</string>
