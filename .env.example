# Copiar a .env y ajustar (no commitear .env)
APP_NAME=EDragonboat API
DEBUG=false
SECRET_KEY=cambiar-por-un-string-largo-aleatorio

ACCESS_TOKEN_EXPIRE_MINUTES=10080
DATABASE_URL=sqlite:///./edragonboat.db
# Orígenes del panel web (coma). Incluir https://app.edragonboat.com cuando exista el DNS.
CORS_ORIGINS=https://app.edragonboat.com,http://localhost:5173,http://127.0.0.1:5173

# Invitaciones: email con contraseña provisional (opcional)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@tudominio.com
# SMTP_USE_TLS=true
# APP_PUBLIC_URL=https://app.edragonboat.com
